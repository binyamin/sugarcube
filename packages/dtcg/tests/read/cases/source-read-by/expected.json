          "from": {
            "sets": ["base"]
          },
          "readBy": "everyone"
        },
        {
          "file": "all.json",
          "pointer": "#/dark",
          "from": {
            "modifier": "mode",
            "context": "dark",
            "sets": []
          },
          "readBy": [
            {
              "mode": "dark"
            }
          ]
        },
        {
          "file": "both.json",
          "from": {
            "modifier": "mode",
            "context": "dark",
            "sets": []
          },
          "readBy": [
            {
              "mode": "light"
            },
            {
              "mode": "dark"
            }
          ]
        },
        {
          "file": "shared.json",
          "from": {
