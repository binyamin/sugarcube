{
  "size": {
    "$type": "dimension",
    "$description": "Sizing steps on a modular scale, fluid between a small and large viewport.",
    "step": {
      "$extensions": {
        "com.example": {
          "measures": "font-size",
          "scale": {
            "mode": "exponential",
            "base": {
              "min": { "value": 1, "unit": "rem" },
              "max": { "value": 1.125, "unit": "rem" }
            },
            "ratio": { "min": 1.2, "max": 1.25 },
            "steps": { "negative": 2, "positive": 5 }
          }
        }
      },
      "-2": { "$value": { "value": 0.694, "unit": "rem" } },
      "-1": { "$value": { "value": 0.833, "unit": "rem" } },
      "0": { "$value": { "value": 1, "unit": "rem" } },
      "1": { "$value": { "value": 1.2, "unit": "rem" } },
      "2": { "$value": { "value": 1.44, "unit": "rem" } },
      "3": { "$value": { "value": 1.728, "unit": "rem" } },
      "4": { "$value": { "value": 2.074, "unit": "rem" } },
      "5": { "$value": { "value": 2.488, "unit": "rem" } }
    },
    "fluid": {
      "$type": "dimension",
      "$description": "Fluid pairs written by hand.",
      "gutter": {
        "$value": { "value": 2, "unit": "rem" },
        "$extensions": {
          "com.example": {
            "fluid": {
              "min": { "value": 1, "unit": "rem" },
              "max": { "value": 2, "unit": "rem" }
            }
          }
        }
      },
      "measure": {
        "$value": { "value": 36, "unit": "rem" },
        "$extensions": {
          "com.example": {
            "fluid": {
              "min": { "value": 20, "unit": "rem" },
              "max": { "value": 36, "unit": "rem" }
            }
          }
        }
      }
    }
  }
}
