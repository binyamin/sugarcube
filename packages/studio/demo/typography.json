{
  "typography": {
    "$description": "An example description",
    "font": {
      "$type": "fontFamily",
      "$description": "An example description",
      "body": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] },
      "system": {
        "$description": "An example description",
        "$value": "system-ui"
      }
    },
    "text": {
      "$type": "dimension",
      "$description": "An example description",
      "$extensions": { "sh.sugarcube": { "measures": "font-size" } },
      "sm": { "$value": "{size.step.-1}" },
      "base": { "$value": "{size.step.0}" },
      "lg": { "$value": "{size.step.1}" },
      "xl": { "$value": "{size.step.2}" },
      "2xl": { "$value": "{size.step.3}" },
      "3xl": { "$value": "{size.step.4}" }
    },
    "leading": {
      "$type": "number",
      "$description": "An example description",
      "tight": { "$value": 1.15 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.7 }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "An example description",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": "semi-bold" },
      "bold": { "$value": "bold" }
    },
    "style": {
      "$type": "typography",
      "$description": "An example description",
      "body": {
        "$description": "An example description",
        "$value": {
          "fontFamily": "{typography.font.body}",
          "fontSize": "{typography.text.base}",
          "fontWeight": "{typography.weight.regular}",
          "lineHeight": "{typography.leading.normal}",
          "letterSpacing": { "value": 0, "unit": "rem" }
        }
      },
      "heading": {
        "$description": "An example description",
        "$value": {
          "fontFamily": "{typography.font.body}",
          "fontSize": "{typography.text.3xl}",
          "fontWeight": "{typography.weight.bold}",
          "letterSpacing": { "value": 0, "unit": "rem" },
          "lineHeight": "{typography.leading.tight}"
        }
      },
      "code": {
        "$description": "An example description",
        "$value": {
          "fontFamily": ["JetBrains Mono", "ui-monospace", "monospace"],
          "fontSize": { "value": 0.875, "unit": "rem" },
          "fontWeight": 400,
          "letterSpacing": { "value": 0, "unit": "rem" },
          "lineHeight": 1.6
        }
      }
    }
  }
}
