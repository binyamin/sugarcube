{
  "space": {
    "$type": "dimension",
    "$description": "An example description",
    "$extensions": {
      "sh.sugarcube": {
        "measures": "gap",
        "scale": {
          "mode": "multipliers",
          "base": { "min": { "value": 1, "unit": "rem" }, "max": { "value": 1.25, "unit": "rem" } },
          "multipliers": { "xs": 0.25, "sm": 0.5, "md": 1, "lg": 1.5, "xl": 2.5, "2xl": 4 }
        }
      }
    }
  }
}
