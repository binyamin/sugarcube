{
  "border": {
    "$description": "An example description",
    "style": {
      "$type": "strokeStyle",
      "$description": "An example description",
      "solid": { "$value": "solid" },
      "dashed": { "$value": "dashed" },
      "dotted": { "$value": "dotted" },
      "custom": {
        "$description": "An example description",
        "$value": {
          "dashArray": [
            { "value": 6, "unit": "px" },
            { "value": 3, "unit": "px" }
          ],
          "lineCap": "round"
        }
      }
    },
    "hairline": {
      "$type": "border",
      "$description": "An example description",
      "$value": {
        "color": "#d1d1d8",
        "width": { "value": 1, "unit": "px" },
        "style": "solid"
      }
    },
    "strong": {
      "$type": "border",
      "$description": "An example description",
      "$value": {
        "color": "{color.border.strong}",
        "width": { "value": 2, "unit": "px" },
        "style": "solid"
      }
    },
    "focus": {
      "$type": "border",
      "$description": "An example description",
      "$value": {
        "color": "{color.brand.500}",
        "width": { "value": 2, "unit": "px" },
        "style": {
          "dashArray": [
            { "value": 4, "unit": "px" },
            { "value": 2, "unit": "px" }
          ],
          "lineCap": "butt"
        }
      }
    }
  }
}
